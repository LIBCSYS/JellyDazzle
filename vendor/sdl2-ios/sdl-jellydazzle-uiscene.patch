+/* JellyDazzle patch (2026-10-08): UIScene lifecycle.
+ * iOS 27 terminates apps that have not adopted UIScene at launch
+ * (_UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption, SIGTRAP).
+ * SDL 2.30 predates that, so: Info.plist names this class as the scene
+ * delegate; it remembers the window scene; postFinishLaunch waits for it; and
+ * every UIWindow SDL makes is created inside it. App-level notifications
+ * (UIApplicationDidEnterBackground etc.) are still posted with one scene, so
+ * SDL's event code needs no change. */
+static UIWindowScene *sdl_scene API_AVAILABLE(ios(13.0));
 
+UIWindowScene *SDL_UIKitActiveScene(void) API_AVAILABLE(ios(13.0)) { return sdl_scene; }
+
+API_AVAILABLE(ios(13.0))
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+@implementation SDLUIKitSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        sdl_scene = (UIWindowScene *)scene;
+        /* windows created before the scene existed (the launch window) join it now */
+        for (UIWindow *w in [UIApplication sharedApplication].windows) {
+            if (w.windowScene == nil) w.windowScene = sdl_scene;
+        }
+    }
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == sdl_scene) sdl_scene = nil;
+}
 @end
 
