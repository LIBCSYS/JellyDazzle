<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mandatory for the Mac App Store. Without it the upload is rejected. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- JellyDazzle reacts to what the Mac is playing, so it needs audio input.
       This is the entitlement behind the NSMicrophoneUsageDescription /
       NSAudioCaptureUsageDescription strings already in Info.plist. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- 3.5.1: files.user-selected.read-only dropped with Open Pictures — back to asking for nothing it cannot justify -->

  <!-- Required the moment an embedded.provisionprofile ships in the bundle:
       the store compares the signature's identifiers against the profile's
       and rejects on absence (ITMS-90886) or mismatch (ITMS-90284). Without
       a profile these were optional — which is why 3.0.2 uploaded clean
       without them and the 2026-10-02 delivery did not. -->
  <key>com.apple.application-identifier</key>
  <string>46AXDWA6F8.nyc.jelia.jellydazzle</string>
  <key>com.apple.developer.team-identifier</key>
  <string>46AXDWA6F8</string>

  <!-- Deliberately NOT requested, and each omission is a question Apple will
       not have to ask:
         com.apple.security.network.client / .server  - the app never talks to
             the network. Claiming it invites "why?" at review.
         com.apple.security.files.user-selected.*     - it opens no documents.
         com.apple.security.device.camera             - no camera use.
       Ask for nothing you cannot justify in one sentence. -->
</dict>
</plist>
